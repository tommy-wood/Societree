{
  "name": "societree",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo/ui": "~58.0.29",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.119.0",
    "expo": "~58.0.26",
    "expo-constants": "~58.0.16",
    "expo-device": "~58.0.5",
    "expo-font": "~58.0.12",
    "expo-glass-effect": "~58.0.5",
    "expo-image": "~58.0.18",
    "expo-image-manipulator": "~58.0.16",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.17",
    "expo-location": "~58.0.22",
    "expo-print": "~58.0.9",
    "expo-router": "~58.0.32",
    "expo-splash-screen": "~58.0.14",
    "expo-status-bar": "~58.0.5",
    "expo-symbols": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "expo-web-browser": "~58.1.0",
    "maplibre-gl": "^6.19.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@types/geojson": "^7946.0.16",
    "@types/node": "^22.20.5",
    "@types/react": "~19.3.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~58.0.4",
    "supabase": "^3.2.0",
    "typescript": "~6.0.3",
    "wrangler": "^4.164.0"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "build:web": "expo export --platform web && node scripts/postbuild-web.mjs dist",
    "typecheck": "tsc --noEmit",
    "seed": "node --env-file-if-exists=.env.local scripts/seed.mjs",
    "test:rls": "node --env-file-if-exists=.env.local scripts/test-rls.mjs",
    "db:types": "supabase gen types typescript --local > src/lib/database.types.ts",
    "seed:sql": "node scripts/make-seed-sql.mjs",
    "test": "node --test src/lib/*.test.ts",
    "test:timesheets": "node --env-file-if-exists=.env.local scripts/test-timesheets.mjs",
    "test:invites": "node --env-file-if-exists=.env.local scripts/test-invites.mjs",
    "postinstall": "node scripts/copy-map-worker.mjs"
  },
  "private": true
}
