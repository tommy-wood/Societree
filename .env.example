# Copy to .env.local and fill in. .env.local is git-ignored.
# Find these in Supabase: Project Settings → API Keys (and Data API for the URL).

# Used by the app (bundled into it, safe to expose: RLS protects the data)
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=sb_publishable_...

# Used ONLY by scripts/seed.mjs on your computer. Bypasses RLS.
# Never commit it, never prefix it with EXPO_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_...
